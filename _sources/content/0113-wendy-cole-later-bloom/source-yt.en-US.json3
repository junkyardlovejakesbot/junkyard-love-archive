    } ]
  }, {
    "tStartMs": 550353,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": " with it, you know?"
    } ]
  }, {
    "tStartMs": 550973,
    "dDurationMs": 7700,
    "segs": [ {
      "utf8": " And I can imagine the beauty of the conversations that must unfold, um, you know, maybe some clunky areas that you probably have to trudge past, but..."
    } ]
  }, {
    "tStartMs": 558673,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": " So, so I was thinking about, you know, what, what I would..."
    } ]
  }, {
    "tStartMs": 562273,
    "dDurationMs": 10100,
    "segs": [ {
      "utf8": " L- like, if, if I was not even, you know, thinking about you, but you sit next to me and then suddenly I'm, I'm in this, you know, i- incredible, interesting conversation about transgenderism, um..."
    } ]
  }, {
    "tStartMs": 572373,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": " Transgenderism is a word, right?"
    } ]
  }, {
    "tStartMs": 574713,
    "dDurationMs": 260,
    "segs": [ {
      "utf8": " Yeah?"
    } ]
  }, {
    "tStartMs": 574973,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": " Is...mm, yeah?"
    } ]
  }, {
    "tStartMs": 575813,
    "dDurationMs": 520,
    "segs": [ {
      "utf8": " Um-"
    } ]
  }, {
    "tStartMs": 576333,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "It can be, yeah."
    } ]
  }, {
    "tStartMs": 576993,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "Okay."
    } ]
  }, {
    "tStartMs": 577893,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": " Well, I, I guess I'm making it a word today."
    } ]
  }, {
    "tStartMs": 579653,
    "dDurationMs": 300,
    "segs": [ {
      "utf8": " Uh, it can-"
    } ]
  }, {
    "tStartMs": 579953,
    "dDurationMs": 140,
    "segs": [ {
      "utf8": "There you go."
    } ]
  }, {
    "tStartMs": 580093,
    "segs": [ {
      "utf8": "..."
