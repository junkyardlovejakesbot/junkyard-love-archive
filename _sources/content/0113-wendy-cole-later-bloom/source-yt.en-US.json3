  }, {
    "tStartMs": 6066591,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": " Possibility."
    } ]
  }, {
    "tStartMs": 6071011,
    "dDurationMs": 60040,
    "segs": [ {
      "utf8": " I think that is an excellent answer."
