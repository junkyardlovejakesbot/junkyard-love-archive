  }, {
    "tStartMs": 6000451,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "Absolutely, me too."
    } ]
  }, {
    "tStartMs": 6001451,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": " I'm, I mean, I really enjoyed our phone conversation just a couple weeks ago."
    } ]
  }, {
    "tStartMs": 6004051,
    "dDurationMs": 8920,
    "segs": [ {
      "utf8": " I feel like I learned so much about you and, um, it, it was really nice to, uh, just, just hear you express yourself and, and hear about your journey and, um, just, just humanize you, you know?"
    } ]
  }, {
    "tStartMs": 6012971,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": " And I love that."
