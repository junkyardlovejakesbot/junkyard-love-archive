    "segs": [ {
      "utf8": "..."
    } ]
  }, {
    "tStartMs": 6297431,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": " Wendy, you have a good day."
    } ]
  }, {
    "tStartMs": 6298811,
    "dDurationMs": 520,
    "segs": [ {
      "utf8": " Thank you so much."
