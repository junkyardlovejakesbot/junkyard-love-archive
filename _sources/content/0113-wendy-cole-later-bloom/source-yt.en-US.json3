      "utf8": "Mm-hmm."
    } ]
  }, {
    "tStartMs": 6288551,
    "segs": [ {
      "utf8": "..."
    } ]
  }, {
    "tStartMs": 6288551,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": " be in more agreement with you on that."
    } ]
  }, {
    "tStartMs": 6290051,
    "dDurationMs": 160,
    "segs": [ {
      "utf8": " I..."
    } ]
  }, {
    "tStartMs": 6290271,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": " That is one of my favorite things ever."
    } ]
  }, {
    "tStartMs": 6292251,
    "dDurationMs": 40,
    "segs": [ {
      "utf8": "Yep."
    } ]
  }, {
    "tStartMs": 6292291,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "So, stretch, drink water, go for a walk, check out Wendy's links below, and, uh-"
    } ]
  }, {
    "tStartMs": 6297331,
    "dDurationMs": 80,
    "segs": [ {
      "utf8": "Yep."
