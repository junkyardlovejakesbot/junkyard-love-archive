  }, {
    "tStartMs": 6271791,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": " If you have not stretched or drank any water today, you're outta your mind."
    } ]
  }, {
    "tStartMs": 6274511,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": " You need to do both."
    } ]
  }, {
    "tStartMs": 6275331,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": " Stretch."
    } ]
  }, {
    "tStartMs": 6276231,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": " I always have to remind everybody those two things."
    } ]
  }, {
    "tStartMs": 6278471,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "Oh, absolutely."
    } ]
  }, {
    "tStartMs": 6279691,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "Those are clear."
    } ]
  }, {
    "tStartMs": 6280371,
    "dDurationMs": 6640,
    "segs": [ {
      "utf8": " Or I would say, I'll add a third because I'm so with you on this one, my favorite things ever is go for a walk and listen to an audiobook."
    } ]
  }, {
