    "dDurationMs": 464,
    "segs": [ {
      "utf8": " Right?"
    } ]
  }, {
    "tStartMs": 6370636,
    "dDurationMs": 12724,
    "segs": [ {
      "utf8": " So that uh, that was just the metaphor of I'm trying to do everything, even in my good deeds as I raised my son and my daughter and my other daughter and I be a good husband to my wife, Lord help me do that."
    } ]
  }, {
    "tStartMs": 6383360,
    "dDurationMs": 2286,
