  }, {
    "tStartMs": 7345144,
    "dDurationMs": 5576,
    "segs": [ {
      "utf8": " And they're doing all these things, and they spend years and years and years of this life trying to even get the torch lit."
    } ]
  }, {
    "tStartMs": 7350880,
    "dDurationMs": 1088,
    "segs": [ {
      "utf8": " And then guess what?"
    } ]
  }, {
    "tStartMs": 7352024,
    "dDurationMs": 3672,
    "segs": [ {
      "utf8": " Then they go and pass it on to their son, who then goes and runs it up, right?"
    } ]
  }, {
    "tStartMs": 7355848,
    "dDurationMs": 28450,
    "segs": [ {
      "utf8": "And so if you are a man in this life, if you never make a million dollars, if you never dream that, have that dream house or that thing, if the last thing that you ever do and the only thing in this physical life that you hang your hat on is that you led your family down the narrow path and that you were the first people in your generation to break all these things and go to the way."
    } ]
  }, {
    "tStartMs": 7384354,
    "dDurationMs": 1608,
    "segs": [ {
      "utf8": " The truth and the light."
    } ]
  }, {
    "tStartMs": 7386146,
    "dDurationMs": 1564,
    "segs": [ {
      "utf8": " You have succeeded."
    } ]
  }, {
    "tStartMs": 7387710,
    "dDurationMs": 7550,
    "segs": [ {
      "utf8": " And that's what I feel like has been on my heart a lot, is because we're so worried about the external things."
    } ]
  }, {
    "tStartMs": 7395380,
    "dDurationMs": 8968,
    "segs": [ {
      "utf8": " We're not understanding, that if we neglect to even get the foundation built, nothing will stand after you go."
    } ]
  }, {
    "tStartMs": 7404404,
    "dDurationMs": 664,
    "segs": [ {
      "utf8": "And guess what?"
    } ]
  }, {
    "tStartMs": 7405124,
    "dDurationMs": 2236,
    "segs": [ {
      "utf8": " Then you have no control of it once you're gone."
    } ]
  }, {
    "tStartMs": 7407360,
    "dDurationMs": 2444,
    "segs": [ {
      "utf8": "Bravo, man."
    } ]
  }, {
    "tStartMs": 7409892,
    "dDurationMs": 1108,
    "segs": [ {
      "utf8": " Beautifully said."
    } ]
  }, {
    "tStartMs": 7411000,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": " Thank you for that."
    } ]
  }, {
    "tStartMs": 7412520,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "Appreciate it, bro."
    } ]
  }, {
    "tStartMs": 7414450,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "All right, Nate, I'll talk to you soon, man."
    } ]
  }, {
    "tStartMs": 7416990,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": " All the love."
    } ]
  }, {
    "tStartMs": 7418080,
    "dDurationMs": 4486,
    "segs": [ {
      "utf8": " Um, yeah, man, just to keep you on the hook."
    } ]
  }, {
    "tStartMs": 7422598,
    "dDurationMs": 1216,
    "segs": [ {
      "utf8": " It was so great to talk to you, man."
    } ]
  }, {
    "tStartMs": 7423902,
    "dDurationMs": 856,
    "segs": [ {
      "utf8": "I'll be in touch."
    } ]
  }, {
    "tStartMs": 7424854,
    "dDurationMs": 1236,
    "segs": [ {
      "utf8": " Peace out, everybody."
    } ]
  }, {
    "tStartMs": 7426090,
    "dDurationMs": 2492,
    "segs": [ {
      "utf8": "Uh, see you."
    } ]
  }, {
    "tStartMs": 7428606,
    "dDurationMs": 536,
    "segs": [ {
      "utf8": " Thanks, guys."
    } ]
  }, {
    "tStartMs": 7429206,
    "dDurationMs": 1088,
    "segs": [ {
      "utf8": " At what age should we learn to."
    } ]
  }, {
    "tStartMs": 7430302,
    "dDurationMs": 2508,
    "segs": [ {
      "utf8": "Have better conversations with ourselves?"
    } ]
  }, {
    "tStartMs": 7432810,
    "dDurationMs": 22400,
    "segs": [ {
      "utf8": "Knowledge is power."
    } ]
  }, {
    "tStartMs": 7455210,
    "dDurationMs": 6380,
    "segs": [ {
      "utf8": "Reality is."
    } ]
  } ]
}
